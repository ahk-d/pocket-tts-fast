{
  "name": "pocket-tts-fast",
  "version": "0.2.0-alpha.0",
  "description": "Optimized Pocket TTS for the browser: dynamic KV caches, streaming audio, stock voices and optional local cloning. Framework-free JavaScript with TypeScript types.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker.js": "./dist/worker.js",
    "./package.json": "./package.json",
    "./voices/alba-casual.emb.npy": "./voices/alba-casual.emb.npy",
    "./voices/alba-casual.en.emb.npy": "./voices/alba-casual.en.emb.npy"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "voices"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:types": "tsc -p tsconfig.json --noEmit && tsc -p test/types/tsconfig.json --noEmit",
    "test:consumers": "node scripts/test-consumers.mjs",
    "test:models": "node --test \"test/models/*.test.mjs\"",
    "pack:check": "npm pack --dry-run --json",
    "stock-voice": "node tools/prepare-stock-voice.mjs",
    "verify-assets": "node tools/verify-assets.mjs",
    "bench": "node bench/bench.mjs",
    "serve": "node tools/serve.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "onnxruntime-web": "1.20.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "pocket-tts",
    "kyutai",
    "onnxruntime-web",
    "wasm",
    "web-worker",
    "german"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahk-d/pocket-tts-fast.git"
  },
  "homepage": "https://github.com/ahk-d/pocket-tts-fast#readme",
  "bugs": {
    "url": "https://github.com/ahk-d/pocket-tts-fast/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Ali",
    "url": "https://github.com/ahk-d"
  }
}
